{
  "version": 1,
  "author": "Ariane Martin",
  "editor": "wokwi",

  "parts": [
    {
      "type": "board-esp32-devkit-c-v4",
      "id": "esp",
      "top": 0,
      "left": 0,
      "attrs": {
        "builder": "esp-idf"
      }
    },
    {
      "type": "wokwi-dht22",
      "id": "dht1",
      "top": 0,
      "left": 180,
      "attrs": {
        "temperature": "25.4",
        "humidity": "61.2"
      }
    },
    {
      "type": "wokwi-photoresistor-sensor",
      "id": "ldr1",
      "top": 180,
      "left": 180,
      "attrs": {
        "lux": "500"
      }
    },
    {
      "type": "board-ssd1306",
      "id": "oled1",
      "top": 20,
      "left": -180,
      "attrs": {
        "i2cAddress": "0x3c"
      }
    },
    {
      "type": "wokwi-ky-040",
      "id": "encoder1",
      "top": 120,
      "left": -360,
      "attrs": {}
    },
    {
      "type": "wokwi-pir-motion-sensor",
      "id": "pir1",
      "top": -180,
      "left": -180,
      "attrs": {}
    },
    {
      "type": "wokwi-buzzer",
      "id": "buzzer1",
      "top": -180,
      "left": 180,
      "attrs": {}
    }
  ],

  "connections": [
    [ "pir1:VCC", "esp:3V3", "red", [] ],
    [ "pir1:GND", "esp:GND.1", "black", [] ],
    [ "pir1:OUT", "esp:27", "green", [] ],

    [ "encoder1:CLK", "esp:32", "purple", [] ],
    [ "encoder1:DT", "esp:33", "orange", [] ],
    [ "encoder1:SW", "esp:25", "yellow", [] ],
    [ "encoder1:+", "esp:3V3", "red", [] ],
    [ "encoder1:GND", "esp:GND.2", "black", [] ],

    [ "oled1:VCC", "esp:3V3", "red", [] ],
    [ "oled1:GND", "esp:GND.1", "black", [] ],
    [ "oled1:SCL", "esp:22", "blue", [] ],
    [ "oled1:SDA", "esp:21", "green", [] ],

    [ "esp:TX", "$serialMonitor:RX", "", [] ],
    [ "esp:RX", "$serialMonitor:TX", "", [] ],

    [ "dht1:VCC", "esp:3V3", "red", [] ],
    [ "dht1:GND", "esp:GND.1", "black", [] ],
    [ "dht1:SDA", "esp:15", "green", [] ],

    [ "ldr1:VCC", "esp:3V3", "red", [] ],
    [ "ldr1:GND", "esp:GND.2", "black", [] ],
    [ "ldr1:AO", "esp:34", "blue", [] ],

    [ "buzzer1:1", "esp:26", "green", [] ],
    [ "buzzer1:2", "esp:GND.1", "black", [] ]
  ],

  "serialMonitor": {
    "display": "always",
    "newline": "lf"
  },

  "dependencies": {}
}